# ─── Royce AI Assistant — Environment Configuration ─────────────
# Copy this file to .env and fill in your keys.

# ─── AI Provider (pick one) ─────────────────────────────────────
# Option 1: Anthropic API (direct)
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-5-20250929
ROYCE_AI_PROVIDER=anthropic

# Option 2: AWS Bedrock (Claude via AWS)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=us-east-1
# ROYCE_AI_PROVIDER=bedrock

# ─── Voice / TTS (ElevenLabs recommended) ──────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# Fallback: AWS Polly
# ROYCE_VOICE=Matthew
# POLLY_ENGINE=neural

# ─── Deep Research ──────────────────────────────────────────────
PERPLEXITY_API_KEY=your_perplexity_key_here
PERPLEXITY_MODEL=sonar-pro

# ─── News Scanning ─────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here
NEWS_REFRESH_MINUTES=15

# ─── AI Image Generation (pick one) ────────────────────────────
# DALL-E (OpenAI)
OPENAI_API_KEY=your_openai_key_here

# Stable Diffusion (Replicate)
# REPLICATE_API_KEY=your_replicate_key_here

# ─── Listening / Speech Recognition ────────────────────────────
MIC_ENERGY_THRESHOLD=3000
PAUSE_THRESHOLD=2.0
LISTEN_TIMEOUT=20
PHRASE_TIME_LIMIT=60
SPEECH_BACKEND=google

# ─── Spotify (optional, for music control) ─────────────────────
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
